  "rules": [
    {
      "title": "Effort",
      "text": "Stop every set when only 0–2 good reps are left. Drop sets only on the last set of an exercise."
    },
    {
      "title": "Progression",
      "text": "Pick a weight that gets you to the bottom of the rep range. When every set hits the top, add weight and start at the bottom again."
    },
    {
      "title": "★ Heavy",
      "text": "Stable lifts where adding weight is the main goal. Unmarked = isolation: lighter, strict, same effort. Rest about 2 min between sets. Workout times assume that and leave out warm-up."
    }
